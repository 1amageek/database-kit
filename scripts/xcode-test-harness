#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCHEME="database-kit-Package"
DESTINATION="platform=macOS,arch=arm64"
EXPECTED_TOOLCHAINS="org.swift.64202608141a"
EXPECTED_SWIFT_SNAPSHOT="swift-6.4.x-DEVELOPMENT-SNAPSHOT-2026-08-14-a"
EXPECTED_SWIFT_COMPILER_COMMIT="424cae54c1a10da"
TEST_TRAITS="${DATABASE_KIT_TEST_TRAITS:-}"
BUILD_TIMEOUT_SECONDS="${XCODE_TEST_BUILD_TIMEOUT_SECONDS:-1200}"
TEST_TIMEOUT_SECONDS="${XCODE_TEST_TIMEOUT_SECONDS:-1200}"
RESULT_DIRECTORY="${XCODE_TEST_RESULT_DIRECTORY:-${TMPDIR:-/tmp}/database-kit-xcode-results}"
WORK_ROOT=""
ONLY_TESTING=()
EXPECTED_TEST_COUNT=""
PRESERVE_WORK_ROOT=false
REUSE_WORK_ROOT=""
HARNESS_LOCK_OWNED=false

usage() {
  cat <<'EOF'
Usage: scripts/xcode-test-harness [options]
  --only-testing <identifier>  Select a test target, suite, or method. Repeatable.
  --expected-count <count>     Required exact positive count for focused tests.
  --preserve-work-root         Preserve source and DerivedData for another run.
  --reuse-work-root <path>     Resynchronize and rebuild a preserved work root.
  -h, --help                  Show this help.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --only-testing|--expected-count|--reuse-work-root)
      if [[ -z "${2:-}" || "$2" == --* ]]; then
        echo "error: $1 requires a value" >&2
        exit 2
      fi
      case "$1" in
        --only-testing) ONLY_TESTING+=("-only-testing:$2") ;;
        --expected-count) EXPECTED_TEST_COUNT="$2" ;;
        --reuse-work-root) REUSE_WORK_ROOT="$2"; PRESERVE_WORK_ROOT=true ;;
      esac
      shift 2
      ;;
    --preserve-work-root) PRESERVE_WORK_ROOT=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if (( ${#ONLY_TESTING[@]} > 0 )); then
  if ! [[ "$EXPECTED_TEST_COUNT" =~ ^[1-9][0-9]*$ ]]; then
    echo "error: focused tests require --expected-count with a positive integer" >&2
    exit 2
  fi
elif [[ -n "$EXPECTED_TEST_COUNT" ]]; then
  echo "error: --expected-count requires --only-testing; full counts are package-owned" >&2
  exit 2
fi

temporary_root="${TMPDIR:-/tmp}"
temporary_root="${temporary_root%/}"
expected_prefix="$temporary_root/database-kit-xcode-test."
if [[ -n "$REUSE_WORK_ROOT" ]]; then
  suffix="${REUSE_WORK_ROOT#"$expected_prefix"}"
  if [[ "$REUSE_WORK_ROOT" != "$expected_prefix"* \
      || ! "$suffix" =~ ^[A-Za-z0-9]+$ \
      || -L "$REUSE_WORK_ROOT" \
      || ! -d "$REUSE_WORK_ROOT/source" || -L "$REUSE_WORK_ROOT/source" \
      || ! -d "$REUSE_WORK_ROOT/DerivedData" || -L "$REUSE_WORK_ROOT/DerivedData" ]]; then
    echo "error: invalid reusable harness work root: $REUSE_WORK_ROOT" >&2
    exit 2
  fi
  if [[ ! -f "$REUSE_WORK_ROOT/.reusable-work-root" \
      || -L "$REUSE_WORK_ROOT/.reusable-work-root" \
      || "$(<"$REUSE_WORK_ROOT/.reusable-work-root")" != "database-kit-xcode-test-work-root-v1" ]]; then
    echo "error: work root was not created for reuse: $REUSE_WORK_ROOT" >&2
    exit 2
  fi
fi

timeout_command() {
  local seconds="$1"
  shift
  perl -e 'alarm shift; exec @ARGV' "$seconds" "$@"
}

cleanup() {
  if [[ -z "$WORK_ROOT" || ! -d "$WORK_ROOT" \
      || "$HARNESS_LOCK_OWNED" != true ]]; then
    return
  fi
  rm -f -- "$WORK_ROOT/.harness-lock/owner-pid"
  rmdir "$WORK_ROOT/.harness-lock"
  HARNESS_LOCK_OWNED=false
  if [[ "$PRESERVE_WORK_ROOT" == true ]]; then
    echo "Preserved harness work root: $WORK_ROOT" >&2
    return
  fi
  if [[ "$WORK_ROOT" != "$expected_prefix"* ]]; then
    echo "error: refusing to remove unexpected harness path: $WORK_ROOT" >&2
    return
  fi
  rm -rf -- "$WORK_ROOT"
}

trap cleanup EXIT

if [[ -n "$REUSE_WORK_ROOT" ]]; then
  WORK_ROOT="$REUSE_WORK_ROOT"
else
  WORK_ROOT="$(mktemp -d "$expected_prefix"XXXXXX)"
fi
if ! mkdir "$WORK_ROOT/.harness-lock" 2>/dev/null; then
  echo "error: harness work root is already in use: $WORK_ROOT" >&2
  exit 2
fi
HARNESS_LOCK_OWNED=true
printf '%s\n' "$$" > "$WORK_ROOT/.harness-lock/owner-pid"
if [[ "$PRESERVE_WORK_ROOT" == true ]]; then
  printf 'database-kit-xcode-test-work-root-v1\n' > "$WORK_ROOT/.reusable-work-root"
fi

prepend_library_path() {
  local plist="$1"
  local dictionary_path="$2"
  local library_path="$3"
  local value_path="$dictionary_path.DYLD_LIBRARY_PATH"
  local existing_value=""

  if ! plutil -extract "$dictionary_path" xml1 -o /dev/null \
      "$plist" >/dev/null 2>&1; then
    plutil -insert "$dictionary_path" -xml '<dict/>' "$plist"
  fi
  if existing_value="$(plutil -extract "$value_path" raw "$plist" 2>/dev/null)"; then
    plutil -replace "$value_path" \
      -string "$library_path:$existing_value" "$plist"
  else
    plutil -insert "$value_path" -string "$library_path" "$plist"
  fi
}

inject_testing_runtime() {
  local plist="$1"
  local swiftc
  local toolchain_root
  local testing_library_path
  local target_count=0
  local configuration_index=0

  swiftc="$(xcrun --toolchain "$TOOLCHAINS" --find swiftc)"
  toolchain_root="$(cd "$(dirname "$swiftc")/../.." && pwd)"
  testing_library_path="$toolchain_root/usr/lib/swift/macosx/testing"
  if [[ ! -f "$testing_library_path/libTesting.dylib" ]]; then
    echo "error: libTesting.dylib is missing from $testing_library_path" >&2
    return 1
  fi

  while plutil -extract "TestConfigurations.$configuration_index.Name" raw \
      "$plist" >/dev/null 2>&1; do
    local target_index=0
    while plutil -extract \
        "TestConfigurations.$configuration_index.TestTargets.$target_index.BlueprintName" \
        raw "$plist" >/dev/null 2>&1; do
      local target_path="TestConfigurations.$configuration_index.TestTargets.$target_index"
      prepend_library_path \
        "$plist" "$target_path.TestingEnvironmentVariables" "$testing_library_path"
      target_count=$((target_count + 1))
      target_index=$((target_index + 1))
    done
    configuration_index=$((configuration_index + 1))
  done

  local top_level_key
  while IFS= read -r top_level_key; do
    if ! plutil -extract "$top_level_key.BlueprintName" raw \
        "$plist" >/dev/null 2>&1; then
      continue
    fi
    prepend_library_path \
      "$plist" "$top_level_key.TestingEnvironmentVariables" "$testing_library_path"
    target_count=$((target_count + 1))
  done < <(
    plutil -p "$plist" \
      | sed -n 's/^  "\([^"]*\)" => {$/\1/p'
  )

  if (( target_count == 0 )); then
    echo "error: no test targets found in $plist" >&2
    return 1
  fi
}

reject_internal_tool_errors() {
  local log_path="$1"
  if rg -n \
      -i -- \
      'internal error:|llvm profile error:|profile.*(error|warning)|warning: input verification failed|warning:.*debug[- ]?information|warning:.*debug info|debug[- ]?information.*(warning|verification|invalid)|debug info.*(warning|verification|invalid)|dwarf.*(warning|verification|invalid)' \
      "$log_path" >&2; then
    echo "error: compiler or toolchain diagnostic detected in $log_path" >&2
    return 1
  fi
}

verify_pinned_toolchain() {
  local toolchain_root
  local toolchain_name
  local compiler_version

  PINNED_SWIFTC="$(xcrun --toolchain "$TOOLCHAINS" --find swiftc)"
  toolchain_root="$(cd "$(dirname "$PINNED_SWIFTC")/../.." && pwd)"
  toolchain_name="${toolchain_root##*/}"
  toolchain_name="${toolchain_name%.xctoolchain}"
  if [[ "$toolchain_name" != "$EXPECTED_SWIFT_SNAPSHOT" ]]; then
    echo "error: expected Swift snapshot $EXPECTED_SWIFT_SNAPSHOT, found $toolchain_name" >&2
    return 1
  fi

  compiler_version="$(xcrun --toolchain "$TOOLCHAINS" swiftc --version)"
  if ! printf '%s\n' "$compiler_version" \
      | rg -F -- "Swift $EXPECTED_SWIFT_COMPILER_COMMIT" >/dev/null; then
    echo "error: expected Swift compiler commit $EXPECTED_SWIFT_COMPILER_COMMIT" >&2
    printf '%s\n' "$compiler_version" >&2
    return 1
  fi
  printf '%s\n' "$compiler_version"
}

summary_number() {
  local summary="$1"
  local key="$2"
  printf '%s' "$summary" | jq -er ".${key}"
}

case "$TEST_TRAITS" in
  "")
    default_expected_test_count=1093
    ;;
  "MultiBase")
    default_expected_test_count=1108
    ;;
  *)
    echo "error: DATABASE_KIT_TEST_TRAITS must be empty or MultiBase" >&2
    exit 2
    ;;
esac
EXPECTED_TEST_COUNT="${EXPECTED_TEST_COUNT:-$default_expected_test_count}"

for command in jq xcodebuild xcrun plutil perl rg rsync shasum tee; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "error: required command not found: $command" >&2
    exit 1
  fi
done

for timeout_value in "$BUILD_TIMEOUT_SECONDS" "$TEST_TIMEOUT_SECONDS"; do
  if ! [[ "$timeout_value" =~ ^[1-9][0-9]*$ ]]; then
    echo "error: XCODE_TEST_BUILD_TIMEOUT_SECONDS and XCODE_TEST_TIMEOUT_SECONDS must be positive integers" >&2
    exit 2
  fi
done

if [[ "${TOOLCHAINS:-}" != "$EXPECTED_TOOLCHAINS" ]]; then
  echo "error: TOOLCHAINS must equal the pinned Swift toolchain $EXPECTED_TOOLCHAINS" >&2
  exit 2
fi

verify_pinned_toolchain

if rg -n '\.package\(path:' "$ROOT_DIR/Package.swift" >/dev/null; then
  echo "error: release verification requires URL dependencies" >&2
  exit 2
fi
if rg -n 'enabledTraits|\.default\s*\(' "$ROOT_DIR/Package.swift" >/dev/null; then
  echo "error: source Package.swift must not enable a default trait" >&2
  exit 2
fi
if [[ ! -f "$ROOT_DIR/Package.resolved" ]]; then
  echo "error: Package.resolved is required for locked verification" >&2
  exit 2
fi
source_package_digest="$(shasum -a 256 "$ROOT_DIR/Package.swift")"
source_resolved_digest="$(shasum -a 256 "$ROOT_DIR/Package.resolved")"

derived_data="$WORK_ROOT/DerivedData"
source_root="$WORK_ROOT/source"
mkdir -p "$source_root" "$derived_data" "$RESULT_DIRECTORY"
normalized_package="$(mktemp "$WORK_ROOT/Package.swift.XXXXXX")"
cp "$ROOT_DIR/Package.swift" "$normalized_package"
if [[ -n "$TEST_TRAITS" ]]; then
  perl -0pi -e '
    my $insertions = s/(\n    traits: \[\n)/$1        .default(enabledTraits: ["MultiBase"]),\n/s;
    die "package trait list was not found\n" unless $insertions == 1;
  ' "$normalized_package"
fi
rsync_arguments=(-a --checksum --delete --exclude '.git' --exclude '.build' \
  --exclude '.swiftpm' --exclude '*.xcresult')
if [[ -n "$REUSE_WORK_ROOT" ]]; then
  if ! cmp -s "$normalized_package" "$source_root/Package.swift" \
      || ! cmp -s "$ROOT_DIR/Package.resolved" "$source_root/Package.resolved"; then
    # A changed manifest or pin graph must not reuse incompatible products.
    rm -rf -- "$derived_data"
    mkdir -p "$derived_data"
  fi
  if cmp -s "$normalized_package" "$source_root/Package.swift"; then
    rsync_arguments+=(--exclude '/Package.swift')
  fi
  if cmp -s "$ROOT_DIR/Package.resolved" "$source_root/Package.resolved"; then
    rsync_arguments+=(--exclude '/Package.resolved')
  fi
fi
rsync "${rsync_arguments[@]}" "$ROOT_DIR/" "$source_root/"
if ! cmp -s "$normalized_package" "$source_root/Package.swift"; then
  mv "$normalized_package" "$source_root/Package.swift"
else
  rm "$normalized_package"
fi
build_root="$source_root"
run_identifier="$(date -u +%Y%m%d-%H%M%S)-$$"
build_result="$RESULT_DIRECTORY/Build-$run_identifier.xcresult"
test_result="$RESULT_DIRECTORY/Test-$run_identifier.xcresult"
build_log="$RESULT_DIRECTORY/Build-$run_identifier.log"
test_log="$RESULT_DIRECTORY/Test-$run_identifier.log"

set +e
(
  cd "$build_root"
  # Xcode evaluates manifests with its bundled toolchain; targets use the pin.
  timeout_command "$BUILD_TIMEOUT_SECONDS" env \
    TOOLCHAINS=com.apple.dt.toolchain.XcodeDefault xcodebuild build-for-testing \
    -scheme "$SCHEME" \
    -destination "$DESTINATION" \
    -derivedDataPath "$derived_data" \
    -resultBundlePath "$build_result" \
    -enableCodeCoverage NO \
    -onlyUsePackageVersionsFromResolvedFile \
    -skipPackageUpdates \
    SWIFT_EXEC="$PINNED_SWIFTC" \
    ${ONLY_TESTING[@]+"${ONLY_TESTING[@]}"} \
    2>&1 | tee "$build_log"
)
build_status=$?
set -e
reject_internal_tool_errors "$build_log"
if ! rg -F -x -- "    SWIFT_EXEC = $PINNED_SWIFTC" "$build_log" >/dev/null; then
  echo "error: build log did not confirm the pinned Swift compiler: $PINNED_SWIFTC" >&2
  exit 1
fi
if (( build_status != 0 )); then
  echo "error: build-for-testing exited with status $build_status" >&2
  exit "$build_status"
fi

xctestrun_paths="$(find "$derived_data/Build/Products" -maxdepth 1 \
  -type f -name '*.xctestrun' ! -name '.configured-*' -print)"
xctestrun_count="$(printf '%s\n' "$xctestrun_paths" | sed '/^$/d' | wc -l | tr -d ' ')"
if [[ "$xctestrun_count" != 1 ]]; then
  echo "error: expected one xctestrun file, found $xctestrun_count" >&2
  printf '%s\n' "$xctestrun_paths" >&2
  exit 1
fi

configured_xctestrun="$(dirname "$xctestrun_paths")/.configured-$run_identifier.xctestrun"
cp "$xctestrun_paths" "$configured_xctestrun"
if ! inject_testing_runtime "$configured_xctestrun"; then
  exit 1
fi

set +e
timeout_command "$TEST_TIMEOUT_SECONDS" env \
  TOOLCHAINS=com.apple.dt.toolchain.XcodeDefault xcodebuild test-without-building \
  -xctestrun "$configured_xctestrun" \
  -destination "$DESTINATION" \
  -resultBundlePath "$test_result" \
  -enableCodeCoverage NO \
  ${ONLY_TESTING[@]+"${ONLY_TESTING[@]}"} \
  2>&1 | tee "$test_log"
test_status=$?
set -e
reject_internal_tool_errors "$test_log"
if (( test_status != 0 )); then
  echo "error: tests exited with status $test_status" >&2
  exit "$test_status"
fi

summary="$(xcrun xcresulttool get test-results summary \
  --path "$test_result" --format json)"
total_count="$(summary_number "$summary" totalTestCount)"
passed_count="$(summary_number "$summary" passedTests)"
failed_count="$(summary_number "$summary" failedTests)"
skipped_count="$(summary_number "$summary" skippedTests)"
expected_failure_count="$(summary_number "$summary" expectedFailures)"
runtime_warning_count="$(printf '%s' "$summary" | jq -er '.runtimeWarnings | length')"
if (( total_count != EXPECTED_TEST_COUNT \
    || passed_count != EXPECTED_TEST_COUNT \
    || failed_count != 0 \
    || skipped_count != 0 \
    || expected_failure_count != 0 \
    || runtime_warning_count != 0 )); then
  printf '%s\n' "$summary" >&2
  echo "error: database-kit result did not meet the strict contract" >&2
  exit 1
fi

if [[ "$(shasum -a 256 "$ROOT_DIR/Package.swift")" != "$source_package_digest" \
    || "$(shasum -a 256 "$ROOT_DIR/Package.resolved")" != "$source_resolved_digest" ]]; then
  echo "error: source Package.swift or Package.resolved changed during verification" >&2
  exit 1
fi

printf '%s\n' "$summary"
echo "database-kit tests: $passed_count passed"
echo "Additional traits: ${TEST_TRAITS:-none}"
echo "Result directory: $RESULT_DIRECTORY"
